# DataHelix `demo-reel` recipe — the `demo` showcase with the conversational
# query panel switched on. This image is the DATA side only: Aperture + Mosaic
# (serve --graphql --mcp) with a synthetic dataset baked in. The planner (Reel)
# runs as a second container — see docker-compose.yml for why.
#
# Built FROM the digest-pinned certified pair (platform ADR-0001), exactly as
# `demo` is — check_pins.py enforces the pins match composition.lock.json.
# The Reel pin lives in docker-compose.yml and is NOT certified; check_pins.py
# reports it separately.
#
# Two datasets, selected by DEMO_DATASET (BuildKit builds only the chosen
# stage):
#   brainbank — the real brainbank-hippo-schema (86 entity types), generated
#               by `demo`'s own build-dataset.sh. Matches `demo`'s screenshots.
#   small     — mosaic-demo-small's fifteen-class schema, generated by that
#               repo's own generate.py. The schema Reel's planner was
#               developed and evaluated against.
#
# `demo`'s build-dataset.sh, remap_accessors.py and entrypoint.sh are reused
# unmodified through the `demo` additional build context (docker-compose.yml),
# not copied, so the two recipes cannot drift.

ARG MOSAIC_IMAGE=ghcr.io/datahelix-platform/mosaic@sha256:27ea806f7cb61bd0217b8b247996196cfb4b6241aa9a06800779484c776d87ed
ARG APERTURE_IMAGE=ghcr.io/bu-neuromics/aperture@sha256:dbe6d7b8b8657e27f79f04e9a7b987df7b32813a3bb5f43b21dcbd11a8c805f6

ARG DEMO_DATASET=brainbank

# Data generator. brainbank uses `demo`'s pin exactly (global-id-uniqueness
# fix, datahelix-platform/linkml-data-gen#3). small needs a different commit: its
# generate.py uses GenerationConfig(hints=...), which that pin lacks — #3 was
# merged onto a side branch, not main. linkml-data-gen main carries hints AND
# its own fix for the same id collisions (#2).
ARG DATAGEN_REPO=https://github.com/datahelix-platform/linkml-data-gen.git
ARG DATAGEN_REF=6d1386f75e400f5e659ff5d7c810adb1914b7131
ARG SMALL_DATAGEN_REF=e0454b2e7e892947b5b3766f2fce440091b406f6
# brainbank: same schema pin as `demo`.
ARG SCHEMA_REPO=https://github.com/VA-NCPTSDBB-Bioinformatics/brainbank-hippo-schema.git
ARG SCHEMA_REF=05c58aa78939a5b9bbcb4d0a3d901a3eab3ca67f
# small: mosaic-demo-small at the commit carrying the fifteen-class schema.
ARG SMALL_REPO=https://github.com/BU-Neuromics/mosaic-demo-small.git
ARG SMALL_REF=739969459b0e1ce3013441eeb9ec7d7dd4ba5e96

FROM ${APERTURE_IMAGE} AS aperture

# ── Shared data-build base: git, inside the pinned runtime ──────────────────
FROM ${MOSAIC_IMAGE} AS data-base
USER root
ARG DATAGEN_REPO
RUN if command -v apt-get >/dev/null; then \
      apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*; \
    fi
WORKDIR /build

# ── brainbank: exactly `demo`'s data stage ──────────────────────────────────
FROM data-base AS data-brainbank
ARG DATAGEN_REF
RUN pip install --no-cache-dir "git+${DATAGEN_REPO}@${DATAGEN_REF}"
ARG SCHEMA_REPO
ARG SCHEMA_REF
ARG DEMO_SEED=0
ARG DEMO_COUNTS="donors=500 samples=3000 datasets=800 assays=800 processes=400 analyses=200"
RUN git clone --depth 1 "${SCHEMA_REPO}" brainbank-hippo-schema \
    && git -C brainbank-hippo-schema fetch --depth 1 origin "${SCHEMA_REF}" \
    && git -C brainbank-hippo-schema checkout -q FETCH_HEAD
COPY --from=demo remap_accessors.py build-dataset.sh /build/
RUN chmod +x build-dataset.sh \
    && DEMO_SEED="${DEMO_SEED}" DEMO_COUNTS="${DEMO_COUNTS}" ./build-dataset.sh
# Discovery cases travel with the schema they describe (`make eval`).
COPY evals/brainbank.yaml /project/evals/discovery.yaml

# ── small: mosaic-demo-small's own generator and Makefile steps ─────────────
# Counts are fixed by that repo's generate.py (COUNT_OVERRIDES, ~8,800
# records); DEMO_COUNTS does not apply. DEMO_SEED does.
FROM data-base AS data-small
ARG SMALL_DATAGEN_REF
RUN pip install --no-cache-dir "git+${DATAGEN_REPO}@${SMALL_DATAGEN_REF}"
ARG SMALL_REPO
ARG SMALL_REF
ARG DEMO_SEED=0
RUN git clone --depth 1 "${SMALL_REPO}" mosaic-demo-small \
    && git -C mosaic-demo-small fetch --depth 1 origin "${SMALL_REF}" \
    && git -C mosaic-demo-small checkout -q FETCH_HEAD
COPY build-small.sh /build/
RUN chmod +x build-small.sh && DEMO_SEED="${DEMO_SEED}" ./build-small.sh

FROM data-${DEMO_DATASET} AS data

# ── Final stage: demo runtime + MCP, dataset baked in ───────────────────────
FROM ${MOSAIC_IMAGE}
ARG MOSAIC_IMAGE
ARG APERTURE_IMAGE
ARG DEMO_DATASET
ARG SCHEMA_REF
ARG SMALL_REF
ARG VERSION=dev
ARG REVISION=unknown

LABEL org.opencontainers.image.title="datahelix-demo-reel" \
      org.opencontainers.image.description="DataHelix demo-reel — Aperture + Mosaic (GraphQL + MCP) with a pre-loaded synthetic dataset, for the conversational query panel" \
      org.opencontainers.image.source="https://github.com/datahelix-platform/datahelix" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.datahelix.solo.mosaic-image="${MOSAIC_IMAGE}" \
      org.datahelix.solo.aperture-image="${APERTURE_IMAGE}" \
      org.datahelix.demo.dataset="${DEMO_DATASET}" \
      org.datahelix.demo.schema-ref="${SCHEMA_REF}" \
      org.datahelix.demo.small-ref="${SMALL_REF}"

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default

COPY --from=aperture /usr/share/nginx/html /srv/aperture
COPY --from=data /project /project

COPY nginx.conf /etc/nginx/conf.d/demo.conf
COPY supervisord.conf /etc/supervisor/conf.d/demo.conf
COPY --from=demo entrypoint.sh /usr/local/bin/demo-entrypoint
RUN chmod +x /usr/local/bin/demo-entrypoint

WORKDIR /project
# 8080: the public origin. 8100: MCP for the planner container only —
# docker-compose.yml never publishes it.
EXPOSE 8080 8100

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

ENTRYPOINT ["/usr/local/bin/demo-entrypoint"]
